# ==========================================
# AgriSense - Docker Compose Configuration
# ==========================================

# PostgreSQL
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# Internal Spring Boot <-> Python authentication
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_internal_token

# JWT authentication (minimum 32 characters)
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Frontend
FRONTEND_PORT=80

# Application
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost

# AWS S3
AWS_REGION=ap-south-1
S3_BUCKET=replace_with_your_s3_bucket_name

# Snowflake
SNOWFLAKE_ACCOUNT=replace_with_account_identifier
SNOWFLAKE_USER=replace_with_username
SNOWFLAKE_PASSWORD=replace_with_password
SNOWFLAKE_ROLE=CAP16_APP_ROLE
SNOWFLAKE_WAREHOUSE=CAP16_WH
SNOWFLAKE_DATABASE=CAP16_ANALYTICS
SNOWFLAKE_SCHEMA=AGRICULTURE