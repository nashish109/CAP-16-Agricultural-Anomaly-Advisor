# AgriSense AI Service configuration
# Copy to .env and adjust as needed.

# Path to a trained PyTorch (.pt / .pth) model weights file.
# If unset or the file does not exist, the service uses MockPredictor.
MODEL_PATH=

# Host/port for local development (used by uvicorn CLI, not required by app)
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
